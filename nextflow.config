// Splicing analysis pipeline: defaults and resource limits.
// Dataset settings come from datasets/<virus>/params.yaml (-params-file);
// input and output locations from the command line (see README).

manifest {
    name            = 'splicing-analysis-pipeline'
    description     = 'Alternative splicing in bulk RNA-seq: fastp, STAR, rMATS'
    nextflowVersion = '!>=26.04.6'
}

params {
    // dataset (params.yaml)
    dataset      = null
    samplesheet  = null
    contrasts    = null
    group_column = null
    pair_column  = null
    adapter      = null

    // locations (command line)
    raw_dir      = null
    star_index   = null
    outdir       = null

    // resources
    max_cpus     = 48     // shared server: never more than this in total
    star_threads = 14
}

executor {
    name   = 'local'
    cpus   = params.max_cpus
    memory = 160.GB
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: 'FASTQC' {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'TRIM_ALIGN' {
        cpus   = params.star_threads
        memory = 40.GB    // STAR peak was 35.7 GB on s001 (index + BAM sort)
    }
}

// Run reports, one set per run, next to the results.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt" }
